<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.moonwitness.orchestrator</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="MoonWitness Orchestrator"
                     string="MoonWitness Orchestrator"
                     name="moonwitness_orchestrator"
                     logo="/moonwitness_base/static/description/icon.png"
                     groups="moonwitness_orchestrator.group_moonwitness_orchestrator">
                    <block title="MoonWitness Orchestrator" name="moonwitness_orchestrator_settings">
                        <setting id="moonwitness_orchestrator_connection_setting"
                                 string="Orchestrator Connection"
                                 help="Configure the internal Fastify orchestrator URL and shared-secret token.">
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="moonwitness_orchestrator_url" string="Orchestrator URL" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="moonwitness_orchestrator_url" nolabel="1" placeholder="http://orchestrator:8090"/>
                                </div>
                                <div class="row mt8">
                                    <label for="moonwitness_orchestrator_token" string="Orchestrator Token" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="moonwitness_orchestrator_token" password="True" nolabel="1"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_test_moonwitness_orchestrator_connection"
                                        type="object"
                                        string="Test Connection"
                                        icon="oi-arrow-right"
                                        class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</flectra>
