    <!-- CORE DIVINITY ENTITIES (KATAPHATIC + APOPHATIC) -->
    <record id="divinity_allah" model="moonwitness.sidra.divinity">
        <field name="urn">mw:divinity:islam:allah</field>
        <field name="name">Allah (الله)</field>
        <field name="tradition_id" ref="tradition_islam"/>
        <field name="epithets">Ar-Rahman, Ar-Rahim, Al-Malik, Al-Quddus, As-Salam, Al-Ahad, As-Samad (99 Asmaul Husna)</field>
        <field name="kataphatic_attributes">Al-Hayy (Ever-Living), Al-Qayyum (Self-Subsisting), Al-Alim (All-Knowing), Al-Qadir (All-Powerful), Ar-Rahman (Most Merciful)</field>
        <field name="apophatic_attributes">Laisa kamitslihi syai'un (QS 42:11 — Nothing resembles Him); Lam yalid wa lam yulad (QS 112:3 — Neither begets nor is born); Not bounded by space, time, body, or multiplicity (Tanzih)</field>
        <field name="provenance_id" ref="provenance_rgbl_root"/>
    </record>

    <record id="divinity_brahman" model="moonwitness.sidra.divinity">
        <field name="urn">mw:divinity:hinduism:brahman</field>
        <field name="name">Brahman (ब्रह्मन्)</field>
        <field name="tradition_id" ref="tradition_hinduism"/>
        <field name="epithets">Sat-Chit-Ananda, Parabrahman, Akshara</field>
        <field name="kataphatic_attributes">Saguna Brahman: Being (Sat), Consciousness (Chit), Bliss (Ananda), ground of cosmic order (Rta)</field>
        <field name="apophatic_attributes">Nirguna Brahman: Neti-Neti (Not this, not this — Brihadaranyaka Upanishad 2.3.6); without qualities, form, or duality</field>
        <field name="provenance_id" ref="provenance_rgbl_root"/>
    </record>

