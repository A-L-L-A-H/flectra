<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="module_category_moonwitness_sidra" model="ir.module.category">
        <field name="name">MoonWitness Sidra</field>
        <field name="description">Access rights for MoonWitness Sidra Knowledge Center</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_moonwitness_sidra_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="module_category_moonwitness_sidra"/>
        <field name="comment">Read-only access to sacred texts, lexicons, traditions, and search.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('moonwitness_base.group_moonwitness_base_user'))]"/>
    </record>

    <record id="group_moonwitness_sidra_scholar" model="res.groups">
        <field name="name">Scholar / Researcher</field>
        <field name="category_id" ref="module_category_moonwitness_sidra"/>
        <field name="comment">Can create and curate assertions, evidence, alignments, commentaries, and motifs.</field>
        <field name="implied_ids" eval="[(4, ref('group_moonwitness_sidra_reader'))]"/>
    </record>

    <record id="group_moonwitness_sidra_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_moonwitness_sidra"/>
        <field name="comment">Full administrative control, corpus ingestion wizards, and system audits.</field>
        <field name="implied_ids" eval="[(4, ref('group_moonwitness_sidra_scholar'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="moonwitness_base.group_moonwitness_base_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_moonwitness_sidra_manager'))]"/>
    </record>
</flectra>
