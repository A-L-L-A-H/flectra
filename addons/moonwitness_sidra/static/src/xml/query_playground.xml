<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="moonwitness_sidra.QueryPlayground">
        <div class="o_sidra_playground p-4">
            <div class="o_sidra_header mb-4">
                <h2 class="mb-1">MoonWitness Sidra — GraphRAG Query Playground</h2>
                <p class="text-muted mb-0">
                    Pencarian lintas tradisi berbasis FTS + Recursive CTE Knowledge Graph dengan verifikasi sitasi anti-halusinasi.
                </p>
            </div>

            <form class="o_sidra_search_form card p-3 mb-4" t-on-submit="onSubmit">
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="sidra_query_input">Kata Kunci / Pertanyaan Riset</label>
                        <input id="sidra_query_input" type="text" class="form-control"
                               placeholder="Contoh: Maha Pengasih, نور, Way, dharma..."
                               t-model="state.query" aria-label="Kata kunci riset Sidra"/>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="sidra_trad_input">Tradisi (opsional)</label>
                        <input id="sidra_trad_input" type="text" class="form-control"
                               placeholder="islam, taoism..." t-model="state.tradition_code"/>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="sidra_lang_input">Bahasa (opsional)</label>
                        <input id="sidra_lang_input" type="text" class="form-control"
                               placeholder="ar, id, en..." t-model="state.language"/>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary" t-att-disabled="state.loading">
                            <t t-if="state.loading">Mencari...</t>
                            <t t-else="">Cari &amp; Verifikasi</t>
                        </button>
                    </div>
                </div>
            </form>

            <div t-if="state.error" class="alert alert-danger" role="alert">
                <t t-esc="state.error"/>
            </div>

            <div t-if="state.result" class="o_sidra_results">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Ringkasan Terverifikasi</strong>
                        <span class="badge bg-success" t-if="state.result.hallucination_score === 0">
                            Hallucination Risk: 0.000 (Grounded)
                        </span>
                        <span class="badge bg-warning text-dark" t-else="">
                            Hallucination Risk: <t t-esc="state.result.hallucination_score"/>
                        </span>
                    </div>
                    <div class="card-body">
                        <pre class="o_sidra_answer mb-3"><t t-esc="state.result.answer"/></pre>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <small class="text-muted">
                                Log #<t t-esc="state.result.query_log_id"/> ·
                                <t t-esc="state.result.verified_citations"/> sitasi terverifikasi ·
                                <t t-esc="state.result.latency_ms"/> ms
                            </small>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Audit Feedback">
                                <button type="button" class="btn btn-outline-success"
                                        t-att-disabled="state.feedbackSent"
                                        t-on-click="() => this.sendFeedback('accurate')">Akurat</button>
                                <button type="button" class="btn btn-outline-secondary"
                                        t-att-disabled="state.feedbackSent"
                                        t-on-click="() => this.sendFeedback('partial')">Parsial</button>
                                <button type="button" class="btn btn-outline-danger"
                                        t-att-disabled="state.feedbackSent"
                                        t-on-click="() => this.sendFeedback('hallucinated')">Halusinasi</button>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mb-2">Kartu Sitasi Korpus (<t t-esc="state.result.citations.length"/>)</h4>
                <div class="row g-3">
                    <div class="col-md-6" t-foreach="state.result.citations" t-as="c" t-key="c.urn">
                        <div class="card h-100 o_sidra_citation_card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong><t t-esc="c.ref"/></strong>
                                    <span class="badge bg-secondary"><t t-esc="c.tradition"/> (<t t-esc="c.language"/>)</span>
                                </div>
                                <p class="mb-2 o_sidra_citation_text"><t t-esc="c.text"/></p>
                                <small class="text-muted d-block">URN: <code><t t-esc="c.urn"/></code> · RRF: <t t-esc="c.rrf_score"/></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
