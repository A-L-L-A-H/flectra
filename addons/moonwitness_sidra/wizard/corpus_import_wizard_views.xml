<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="view_sidra_import_wizard_form" model="ir.ui.view">
        <field name="name">moonwitness.sidra.import.wizard.form</field>
        <field name="model">moonwitness.sidra.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import RGBL Multi-Tradition Corpus">
                <sheet>
                    <div class="oe_title">
                        <h1>MoonWitness Sidra Corpus Ingestion</h1>
                    </div>
                    <p class="text-muted">
                        Seluruh 54 dataset korpus RGBL sudah dibundel di dalam addon ini dan otomatis dimuat saat instalasi.
                        Klik tombol di bawah untuk memuat ulang atau mengimpor dataset kustom.
                    </p>
                    <group>
                        <field name="batch_size"/>
                        <field name="dataset_dir"/>
                        <field name="tradition_code"/>
                    </group>
                    <group string="Execution Diagnostics" invisible="not result_log">
                        <field name="result_log" widget="text" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_bundled" string="Load All Bundled Default Datasets" type="object" class="btn-primary"/>
                    <button name="action_import" string="Import Custom Folder" type="object" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sidra_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Corpus Dataset</field>
        <field name="res_model">moonwitness.sidra.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</flectra>
