<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="res_config_settings_view_form_moonwitness_corpus" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.moonwitness.corpus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="moonwitness_corpus" string="MoonWitness Corpus"
                     data-string="MoonWitness Corpus" groups="base.group_system">
                    <block title="Corpus API" name="moonwitness_corpus_api">
                        <setting id="moonwitness_corpus_api_url"
                                 string="API URL"
                                 help="Base URL of the MoonWitness Corpus API, without /v1.">
                            <field name="moonwitness_corpus_api_url"
                                   placeholder="https://corpus.example.org"/>
                        </setting>
                        <setting id="moonwitness_corpus_timeout"
                                 string="Request timeout"
                                 help="Maximum read timeout in seconds (2–30).">
                            <field name="moonwitness_corpus_timeout"/>
                        </setting>
                        <setting id="moonwitness_corpus_verify_ssl"
                                 string="Verify TLS certificates"
                                 help="Keep enabled for production HTTPS endpoints.">
                            <field name="moonwitness_corpus_verify_ssl"/>
                        </setting>
                        <setting id="moonwitness_corpus_connection_actions"
                                 string="Connection and catalog">
                            <div class="content-group">
                                <button name="action_test_moonwitness_connection"
                                        type="object" string="Test Connection"
                                        class="btn-link" icon="fa-plug"/>
                                <button name="action_sync_moonwitness_catalog"
                                        type="object" string="Sync Catalog Metadata"
                                        class="btn-link" icon="fa-refresh"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</flectra>
