# Base URL of the Flectra server. Keep this server-only; never use NEXT_PUBLIC_.
FLECTRA_URL=http://localhost:8069

# PostgreSQL
POSTGRES_USER=flectra
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=flectra

# Flectra master password (not the PostgreSQL password)
ADMIN_PASSWD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_MASTER_PASSWORD

# Internal service tokens
PANEL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_PANEL_TOKEN
ORCHESTRATOR_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ORCHESTRATOR_TOKEN

# Host ports
FLECTRA_PORT=8069
FLECTRA_GEVENT_PORT=8072

# Bind to localhost when a reverse proxy runs on this host.
# Use 0.0.0.0 only when direct access from other hosts is intended.
FLECTRA_BIND_IP=127.0.0.1

# Optional Flectra features
LIST_DB=false
DEFAULT_PRODUCTIVITY_APPS=false
PROXY_MODE=false
